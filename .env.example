# Copy this file to .env on the Docker host and fill in real values.
# .env is gitignored - never commit real credentials.

# Where Kikusan downloads land (you move files you want to keep into
# Navidrome's actual music folder yourself)
MUSIC_HOLDING_DIR=D:/Music_Holding

# Navidrome connection (use its LAN IP so this works regardless of whether
# Kikusan ends up on the same machine as Navidrome or a different one)
NAVIDROME_URL=http://192.168.144.53:4533
NAVIDROME_USER=your-navidrome-username
NAVIDROME_PASSWORD=your-navidrome-password
NAVIDROME_KEEP_PLAYLIST=keep

# File layout: "flat" (all files in one folder) or "album"
# (Artist/Album (Year)/Track.ext, matching Navidrome's expected layout)
KIKUSAN_ORGANIZATION_MODE=album

# Cookie usage: "auto" (only fall back to cookies on detected auth errors),
# "always" (use uploaded cookies.txt for every request), or "never"
KIKUSAN_COOKIE_MODE=always

# PO token provider used so YouTube stops stripping formats from age-restricted
# or bot-flagged requests, even when valid cookies are supplied. Points at the
# bgutil-pot-provider sidecar service defined in docker-compose.yml - leave as
# the default unless you're running the provider elsewhere. Set to an empty
# value to disable.
KIKUSAN_POT_PROVIDER_URL=http://bgutil-pot-provider:4416
